my_dbt_project/
├── .vscode/                               # Local VSCode settings
│   └── settings.json
├── .gitignore                             # Ignores target/ and local profiles
├── README.md                              # Setup instructions
├── dbt_project.yml                        # Core project configuration
├── packages.yml                           # dbt-utils package
├── profiles.yml                           # Snowflake connection profiles
├── macros/                                # Reusable Jinja macros
│   └── generate_schema_name.sql           # Schema routing (dev vs prod)
├── seeds/                                 # Small reference CSV files
└── models/                                # TRANSFORMATION LAYERS
    ├── staging/                           # LAYER 1: Raw Sources & Clean Cleanup
    │   └── tpch/                          # SNOWFLAKE_SAMPLE_DATA source folder
    │       ├── src_tpch.yml               # Declares PART, ORDERS, CUSTOMER, LINEITEM
    │       ├── stg_tpch__customers.sql
    │       ├── stg_tpch__orders.sql
    │       ├── stg_tpch__lineitem.sql
    │       └── stg_tpch__part.sql
    ├── intermediate/                      # LAYER 2: Joins & Aggregations
    │   ├── int_order_items.sql            # Joins orders + lineitems
    │   └── int_customer_orders.sql        # Aggregates orders per customer
    └── marts/                             # LAYER 3: Business & Observability Models
        ├── core/                          # Production Business Models
        │   ├── dim_customers.sql
        │   └── fct_orders.sql
        └── observability/                 # Pipeline Health Models
            └── fct_pipeline_health_daily.sql


